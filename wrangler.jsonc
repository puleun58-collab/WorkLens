{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worklens",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "!/_next/static/*"]
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "b14d2e47bfbb4ea7ae3475b772dceecf"
    }
  ],
  "d1_databases": [
    {
      "binding": "WORKLENS_CONFIG_DB",
      "database_name": "worklens-config",
      "database_id": "d3be8da1-440f-450a-9ae0-cde929f0cfe9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WORKLENS_ORIGIN": "https://worklens.puleun58.workers.dev",
    "LAW_MCP_URL": "https://mcp.gomdori.app/law"
  }
}
