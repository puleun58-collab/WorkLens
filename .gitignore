.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
.vinext/
.wrangler/

# generated browser assets
/public/pdf.worker.mjs

# Local-only secrets for wrangler dev
.dev.vars
.dev.vars.*
