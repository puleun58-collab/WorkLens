{
  "name": "worklens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "parser:build": "bun scripts/build-parser.ts",
    "dev": "bun run parser:build && next dev",
    "build": "bun run parser:build && next build",
    "start": "next start",
    "ephemeral:up": "docker compose up -d valkey minio",
    "ephemeral:down": "docker compose down --remove-orphans",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun run parser:build && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "undici": "^8.10.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fflate": "0.8.3",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
