{
  "name": "worklens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:pdf": "bun scripts/copy-pdf-worker.ts",
    "dev": "bun run assets:pdf && next dev",
    "build": "bun run assets:pdf && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun run assets:pdf && vitest run",
    "test:e2e": "playwright test",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "bun run assets:pdf && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vinext build && bun scripts/write-asset-headers.ts",
    "start:vinext": "bun scripts/start-worker.ts",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "bun run build:vinext && wrangler deploy --config dist/server/wrangler.json",
    "test:e2e:cloudflare": "bun run build:vinext && playwright test --config playwright.cloudflare.config.ts",
    "test:e2e:cloudflare:run": "playwright test --config playwright.cloudflare.config.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:eval:retrieval": "vitest run tests/eval-retrieval.test.ts",
    "test:eval:grounding": "vitest run tests/eval-grounding.test.ts",
    "bench:large": "bun tests/bench/large-documents.ts",
    "bench:stress": "bun tests/bench/large-documents.ts --stress"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "saxes": "6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fflate": "0.8.3",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}
